# Local FastAPI development server
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Local PostgreSQL/TimescaleDB connection
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=codetrace
DB_USER=codetrace
DB_PASSWORD=codetrace_local_only

## Gemini API key for C3
GEMINI_API_KEY=paste_your_key_here
PROBING_REVIEWER_ENABLED=true
PROBING_ALLOW_SAME_FAMILY_REVIEWER=true

## GROQ API key for C3
GROQ_API_KEY=paste_your_key_here